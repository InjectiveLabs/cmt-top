# cmt-top — environment variables
#
# Copy this file to `.env` and edit. Values here override the TOML config but
# are themselves overridden by CLI flags. Anything left unset falls back to the
# baked-in Injective defaults.
#
# Precedence (lowest → highest):
#   defaults  <  config.toml  <  $CMTOP_*  <  CLI flags

# ---- Chain endpoints ----------------------------------------------------------

# Primary CometBFT RPC (HTTP+WS).
# Note: CMTOP_RPC accepts ONE URL. For multi-RPC failover, use config.toml.
CMTOP_RPC=https://tm.injective.network

# Cosmos LCD/REST endpoint — used to enrich monikers, fetch upgrade plan.
CMTOP_LCD=https://lcd.injective.network

# Comma-separated list of extra RPCs to cross-check AppHash (optional).
# CMTOP_MONITORED_RPCS=https://injective-rpc.publicnode.com:443,https://rpc.injective.posthuman.digital

# Bech32 prefix for operator addresses (default: inj).
CMTOP_BECH32_PREFIX=inj

# ---- UI / network -------------------------------------------------------------

# tui | web | both | headless
CMTOP_MODE=web

# Bind address for local web UI / REST API. Compose overrides this inside its container.
# A non-loopback address (e.g. 0.0.0.0) without CMTOP_WEB_TOKEN logs a warning at startup.
CMTOP_WEB_LISTEN=127.0.0.1:8080

# Browser admission and requests/second per global lane (also per resolved API client IP).
CMTOP_WEB_MAX_CLIENTS=256
CMTOP_WEB_API_RATE_LIMIT=600
# Comma-separated trusted proxy CIDRs; unset ignores forwarding headers.
# CMTOP_WEB_TRUSTED_PROXIES=

# Bearer token for /api/* and /ws. Recommended when binding non-loopback.
# Leave empty for loopback-only deployments.
# Generate one: `openssl rand -hex 32`
# CMTOP_WEB_TOKEN=

# Bind address for the Prometheus /metrics listener.
# Compose overrides this to 0.0.0.0:9091 inside the container.
# CMTOP_METRICS_LISTEN=127.0.0.1:9091

# ---- Logging ------------------------------------------------------------------

# debug | info | warn | error
CMTOP_LOG_LEVEL=info
